# Copy to .env.local and fill in. Never commit .env.local.

# --- Part A (foundation): nothing required. The site runs with no services. ---

# --- Part B (accounts and database): Supabase project > Settings > API ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser. Used by public gift pages,
# event and response writes, the point ledger, and the RLS tests.
SUPABASE_SERVICE_ROLE_KEY=

# Public origin used to build OAuth return URLs. Optional locally.
# NEXT_PUBLIC_SITE_URL=http://localhost:5173

# --- Later: analytics (optional) ---
# NEXT_PUBLIC_POSTHOG_KEY=
