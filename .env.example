# Copy to .env.local and fill in. Never commit .env.local.
# (A file named .env works too. Next.js and the test scripts read both; .env.local wins.)
# Never put real keys in this file: it is committed to git.

# --- Supabase: project > Settings > API ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser. Used by public gift pages,
# event and response writes, the point ledger, and the tests.
SUPABASE_SERVICE_ROLE_KEY=

# Public origin of the user site. Required in production for share links,
# OAuth return URLs, sitemap and social images.
NEXT_PUBLIC_SITE_URL=http://localhost:5173

# Origin of the admin site when it runs separately (pnpm dev:admin).
# Leave unset to serve /admin from the user site.
NEXT_PUBLIC_ADMIN_SITE_URL=http://localhost:5174

# Shared secret for the daily keep-alive cron (vercel.json). Any long random string.
# CRON_SECRET=

# "Continue with Google": the web OAuth client id from Google Cloud (docs/SETUP.md, Part B).
# The same id is set in the Supabase Google provider. The button is hidden when unset.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Google Search Console ownership code (the content of its "HTML tag" option).
# Leave unset until the site is added to Search Console.
# GOOGLE_SITE_VERIFICATION=

# Shown on the Contact page. Leave unset to show the "coming soon" text.
# NEXT_PUBLIC_CONTACT_EMAIL=

# Where customers pay for paid-only templates (wedding, engagement), shown on
# /dashboard/buy/<template>. Server only. With no wallet number set, the page
# says buying opens soon. The contact link must be https (m.me, Viber, t.me).
# EAIN_PAY_NAME=
# EAIN_PAY_KBZPAY=
# EAIN_PAY_WAVEPAY=
# EAIN_SALES_CONTACT_URL=https://m.me/<your-page>

# Optional server-side product analytics. Off when unset.
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
