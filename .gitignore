# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# keep the example env file in git
!.env.example

# generated from supabase/migrations for manual SQL editor runs
/supabase/ALL_MIGRATIONS.sql

# supabase cli scratch
/supabase/.temp/

# raw brand exports are processed by scripts/process-brand-images.mjs; keep only outputs
/public/brand/couple.png
/public/brand/female.png
/public/brand/male.png
/public/brand/eain-mainLogo2.png
/public/brand/eain-appIcon.png
